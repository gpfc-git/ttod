---
/**
 * La ruta que no existe: el sendero que se pierde en la niebla.
 *
 * Astro sirve esta vista (con estado 404) para toda ruta sin página. El idioma
 * sale del prefijo (/es, /en) y, si no lo hay, de Accept-Language.
 *
 * La cita no se escribe aquí: es `img-116` (es) / `img-024` (en) del corpus,
 * pedida al backend como el resto del sitio. Si el backend no responde, la
 * vista se queda sin cita antes que inventarla.
 */
import Page from '../layouts/Page.astro';
import type { WisdomEntry } from '../types/domain';

export const prerender = false;

// La cita es fija y gobernada: se pide una vez y se guarda en memoria. Un 404
// no espera al corpus más de un segundo y medio; si tarda más, esta visita sale
// sin cita (nunca con una inventada) y la petición sigue para las siguientes.
const IDS = { es: 'img-116', en: 'img-024' } as const;
// En globalThis y no en el módulo: en desarrollo Astro vuelve a evaluar esta
// página en cada 404 y la memoria se perdía.
const memoria = ((globalThis as any).__ttodCitas404 ??= { citas: new Map<string, WisdomEntry>(), pendiente: null }) as {
  citas: Map<string, WisdomEntry>; pendiente: Promise<void> | null;
};
const { citas } = memoria;
function pedirCitas() {
  memoria.pendiente ??= fetch(`${import.meta.env.BACKEND_URL ?? 'http://backend:8000'}/api/v1/wisdom/sample`)
    .then((r) => (r.ok ? (r.json() as Promise<WisdomEntry[]>) : Promise.reject(r.status)))
    .then((corpus) => {
      for (const [lang, id] of Object.entries(IDS)) {
        const e = corpus.find((x) => x.id === id && x.lang === lang);
        if (e) citas.set(lang, e);
      }
    })
    .catch(() => { memoria.pendiente = null; });
  return memoria.pendiente;
}
async function citaDelCorpus(lang: 'es' | 'en') {
  if (!citas.has(lang)) await Promise.race([pedirCitas(), new Promise((r) => setTimeout(r, 1500))]);
  return citas.get(lang);
}
Astro.response.status = 404;

const prefijo = Astro.url.pathname.split('/')[1];
const lang: 'es' | 'en' =
  prefijo === 'es' || prefijo === 'en'
    ? prefijo
    : (Astro.request.headers.get('accept-language') ?? '')
        .split(',')
        .map((l) => l.trim().slice(0, 2).toLowerCase())
        .find((l): l is 'es' | 'en' => l === 'es' || l === 'en') ?? 'en';

const cita = await citaDelCorpus(lang);

const t = {
  es: {
    title: 'Sendero perdido · TTOD',
    description: 'Esta ruta no existe en TTOD. Desde aquí vuelves al inicio, a la sabiduría, al grafo o al oráculo.',
    ojo: 'Error 404',
    h1: 'El sendero se pierde en la niebla.',
    lead: 'No hay ninguna página en',
    lead2: 'Puede que se haya movido, o que nunca estuviera.',
    volver: 'Volver al camino',
    links: [
      { href: '/es/', label: 'Volver al inicio' },
      { href: '/es/wisdom/', label: 'Sabiduría' },
      { href: '/es/graph', label: 'Grafo' },
      { href: '/es/oracle', label: 'Oráculo' },
    ],
    fuente: 'Cita del corpus',
  },
  en: {
    title: 'Lost path · TTOD',
    description: 'This route does not exist in TTOD. From here you can return home, to wisdom, the graph or the oracle.',
    ojo: 'Error 404',
    h1: 'The path fades into the mist.',
    lead: 'There is no page at',
    lead2: 'It may have moved, or it may never have been here.',
    volver: 'Back to the path',
    links: [
      { href: '/en/', label: 'Back to home' },
      { href: '/en/wisdom/', label: 'Wisdom' },
      { href: '/en/graph', label: 'Graph' },
      { href: '/en/oracle', label: 'Oracle' },
    ],
    fuente: 'Quote from the corpus',
  },
}[lang];
const [inicio, ...resto] = t.links;
---
<Page lang={lang} title={t.title} description={t.description}>
  <main class="perdido">
    <div class="escena" aria-hidden="true">
      <svg class="sendero" viewBox="0 0 400 600" preserveAspectRatio="xMidYMax slice" focusable="false">
        <defs>
          <linearGradient id="sendero-aguada" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#1b1710" stop-opacity=".62" />
            <stop offset=".45" stop-color="#3b3122" stop-opacity=".34" />
            <stop offset=".82" stop-color="#544b3c" stop-opacity="0" />
          </linearGradient>
          <filter id="sendero-pincel" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.018 0.05" numOctaves="3" seed="3" />
            <feDisplacementMap in="SourceGraphic" scale="9" />
          </filter>
