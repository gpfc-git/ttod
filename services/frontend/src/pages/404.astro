        <g class="sendero-tinta" filter="url(#sendero-pincel)" fill="none" stroke="url(#sendero-aguada)" stroke-linecap="round">
        <path class="sendero-cerda" d="M159.6 651.9 L153.6 642.5 L148.1 633.1 L143.2 623.7 L138.9 614.2 L135.2 604.8 L132.1 595.3 L129.6 586.0 L127.6 576.7 L126.3 567.5 L125.5 558.4 L125.3 549.6 L125.5 540.9 L126.3 532.5 L127.5 524.3 L129.1 516.4 L131.0 508.7 L133.2 501.3 L135.7 494.1 L138.4 487.1 L141.3 480.3 L144.4 473.7 L147.7 467.3 L151.0 461.0 L154.5 454.8 L158.0 448.7 L161.6 442.7 L165.3 436.7 L168.9 430.8 L172.6 424.9 L176.3 419.0 L180.0 413.1 L183.7 407.1 L187.3 401.2 L190.9 395.2 L194.5 389.1 L197.9 383.0 L201.3 376.9 L204.5 370.6 L207.6 364.3 L210.6 357.8 L213.5 351.3 L216.2 344.6 L218.7 337.8 L221.0 330.9 L223.1 323.8 L225.0 316.6 L226.6 309.2 L228.0 301.7 L229.0 294.0 L229.8 286.2 L230.3 278.1 L230.4 269.9 L230.1 261.5 L229.5 252.9 L228.4 244.1 L227.0 235.1 L225.1 225.9 L222.7 216.5 L219.9 207.0 L216.5 197.2" stroke-width="1.6" />
        <path class="sendero-cerda" d="M191.8 623.6 L186.1 616.2 L181.0 608.9 L176.4 601.6 L172.3 594.3 L168.7 587.1 L165.6 579.9 L162.9 572.8 L160.8 565.7 L159.1 558.7 L157.8 551.7 L157.0 544.9 L156.6 538.1 L156.5 531.4 L156.8 524.8 L157.5 518.2 L158.4 511.8 L159.6 505.4 L161.1 499.1 L162.8 492.8 L164.7 486.6 L166.8 480.5 L169.1 474.4 L171.5 468.3 L174.1 462.2 L176.8 456.1 L179.6 450.1 L182.4 444.0 L185.4 437.9 L188.4 431.8 L191.4 425.6 L194.5 419.4 L197.5 413.2 L200.5 406.9 L203.6 400.5 L206.5 394.1 L209.4 387.6 L212.3 381.1 L215.0 374.4 L217.7 367.7 L220.2 360.8 L222.5 353.9 L224.7 346.9 L226.8 339.7 L228.6 332.5 L230.3 325.1 L231.7 317.6 L232.9 309.9 L233.8 302.2 L234.4 294.2 L234.8 286.2 L234.8 278.0 L234.5 269.6 L233.8 261.0 L232.8 252.4 L231.4 243.5 L229.6 234.5 L227.4 225.3 L224.8 215.9 L221.7 206.3 L218.1 196.6" stroke-width="0.9" />
        <path class="sendero-cerda" d="M227.0 592.7 L221.7 587.5 L216.8 582.4 L212.5 577.4 L208.6 572.6 L205.1 567.8 L202.1 563.0 L199.3 558.4 L197.0 553.7 L194.9 549.1 L193.1 544.4 L191.7 539.8 L190.5 535.0 L189.5 530.2 L188.9 525.3 L188.5 520.2 L188.3 515.1 L188.4 509.9 L188.8 504.5 L189.4 499.1 L190.2 493.5 L191.2 487.8 L192.4 482.1 L193.9 476.2 L195.5 470.3 L197.2 464.2 L199.1 458.1 L201.2 451.9 L203.3 445.7 L205.5 439.3 L207.8 432.9 L210.2 426.4 L212.6 419.8 L215.0 413.1 L217.3 406.4 L219.7 399.5 L222.0 392.6 L224.3 385.6 L226.5 378.6 L228.6 371.4 L230.5 364.2 L232.4 356.8 L234.1 349.4 L235.6 341.8 L236.9 334.2 L238.1 326.5 L239.0 318.6 L239.7 310.7 L240.1 302.6 L240.3 294.5 L240.1 286.2 L239.7 277.8 L239.0 269.2 L237.9 260.6 L236.5 251.8 L234.7 242.9 L232.6 233.8 L230.0 224.5 L227.0 215.2 L223.7 205.6 L219.8 195.9" stroke-width="1.3" />
        <path class="sendero-cerda" d="M256.3 567.0 L251.2 563.6 L246.7 560.4 L242.6 557.3 L238.9 554.5 L235.6 551.7 L232.5 549.0 L229.7 546.4 L227.1 543.8 L224.7 541.1 L222.5 538.4 L220.5 535.5 L218.7 532.4 L217.0 529.2 L215.6 525.7 L214.3 521.9 L213.2 517.9 L212.4 513.6 L211.8 509.1 L211.5 504.3 L211.4 499.2 L211.5 494.0 L211.9 488.5 L212.5 482.8 L213.3 477.0 L214.3 471.0 L215.5 464.8 L216.8 458.5 L218.3 452.1 L219.8 445.6 L221.5 438.9 L223.3 432.1 L225.1 425.3 L227.0 418.3 L228.8 411.2 L230.7 404.1 L232.5 396.8 L234.3 389.5 L236.0 382.0 L237.7 374.5 L239.2 366.9 L240.6 359.2 L241.9 351.5 L243.0 343.6 L243.9 335.7 L244.6 327.6 L245.1 319.5 L245.4 311.3 L245.4 303.0 L245.2 294.7 L244.6 286.2 L243.8 277.6 L242.7 269.0 L241.3 260.2 L239.5 251.3 L237.4 242.3 L235.0 233.2 L232.1 224.0 L228.9 214.6 L225.3 205.0 L221.3 195.3" stroke-width="0.8" />
        </g>
      </svg>
      <div class="niebla niebla-1"></div>
      <div class="niebla niebla-2"></div>
      <div class="niebla niebla-3"></div>
    </div>

    <div class="texto">
      <p class="ojo">{t.ojo}</p>
      <h1>{t.h1}</h1>
      <p class="lead">{t.lead} <code>{Astro.url.pathname}</code>. {t.lead2}</p>
      {cita && (
        <figure class="cita">
          <blockquote lang={cita.lang}><p>«{cita.text}»</p></blockquote>
          <figcaption><a href={`/${lang}/wisdom/${cita.id}`}>{t.fuente} · {cita.id}</a></figcaption>
        </figure>
      )}
    </div>

    <nav class="salidas" aria-label={t.volver}>
      <a class="salida-principal" href={inicio.href}>{inicio.label}</a>
      <ul>
        {resto.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </main>
</Page>

<style>
  .perdido {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    min-height: calc(100svh - 5rem);
    margin-top: -0.5rem;
    padding: clamp(2rem, 7vh, 4rem) 1rem 1.5rem;
  }
  .escena { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .sendero { position: absolute; left: 0; bottom: 0; width: 100%; height: 78%; }
  .sendero-cerda { opacity: .55; }
  

  /* Niebla: manchas suaves de papel claro, sin desenfoque (un radial ya lo es);
     se mueven poco y despacio, como la bruma de un valle. */
  .niebla {
    position: absolute; left: -30%; width: 160%; height: 26%;
    background: radial-gradient(closest-side, rgb(242 236 218 / .95), rgb(242 236 218 / .55) 55%, rgb(242 236 218 / 0));
  }
  .niebla-1 { top: 22%; }
  .niebla-2 { top: 34%; left: -55%; height: 20%; opacity: .85; }
  .niebla-3 { top: 44%; left: -10%; height: 16%; opacity: .6; }

  .texto { position: relative; max-width: 34rem; }
  .ojo {
    margin: 0 0 1rem; font-family: var(--ttod-font-ui); font-size: var(--ttod-text-ui);
    letter-spacing: var(--ttod-tracking-ui); text-transform: uppercase; font-weight: 500; color: var(--ttod-color-seal);
  }
  h1 {
    margin: 0; font-family: var(--ttod-font-titular); font-weight: 300;
    font-size: clamp(2.5rem, 11vw, 5rem); line-height: 1.02; letter-spacing: -.01em; text-wrap: balance;
  }
  .lead { margin: 1.25rem 0 0; max-width: 32rem; color: var(--ttod-color-muted); }
  .lead code {
    font-family: var(--ttod-font-ui); font-size: .9em; overflow-wrap: anywhere;
    color: var(--ttod-color-ink); background: rgb(27 23 16 / .07); padding: .05em .35em; border-radius: .3em;
  }
  .cita { margin: 2rem 0 0; padding-inline-start: 1rem; border-inline-start: 2px solid var(--ttod-color-seal); }
  .cita blockquote { margin: 0; }
  .cita p { margin: 0; font-size: var(--ttod-text-lg); line-height: 1.45; font-style: italic; }
  .cita figcaption { margin-top: .25rem; font-family: var(--ttod-font-ui); font-size: var(--ttod-text-sm); }
  .cita a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ttod-color-accent); }

  .salidas { position: relative; display: grid; gap: .75rem; width: min(100%, 34rem); }
  .salidas ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .salidas a {
    display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 .75rem;
    border-radius: 999px; text-decoration: none; font-family: var(--ttod-font-ui);
    font-size: var(--ttod-text-ui); letter-spacing: .1em; text-transform: uppercase; font-weight: 500;
    transition: background-color .25s ease, color .25s ease, transform .3s cubic-bezier(.2, .7, .3, 1);
  }
  .salida-principal { min-height: 54px !important; background: var(--ttod-color-ink); color: rgb(var(--ttod-paper-rgb)); }
  .salidas ul a { background: rgb(242 236 218); color: var(--ttod-color-ink); border: 1px solid rgb(27 23 16 / .28); }
  .salidas a:hover { transform: translateY(-2px); }
  .salidas ul a:hover { background: var(--ttod-color-ink); color: rgb(var(--ttod-paper-rgb)); }
  .perdido a:focus-visible { outline: 3px solid var(--ttod-color-focus); outline-offset: 3px; }

  @media (prefers-reduced-motion: no-preference) {
    /* Se anima la capa entera, no el trazo filtrado: el pincel se pinta una vez. */
    .sendero { transform-origin: 50% 100%; animation: sendero-entra 2s cubic-bezier(.2, .7, .2, 1) both; }
    .niebla-1 { animation: niebla 26s ease-in-out -4s infinite alternate; }
    .niebla-2 { animation: niebla 34s ease-in-out -12s infinite alternate-reverse; }
    .niebla-3 { animation: niebla 41s ease-in-out infinite alternate; }
    /* El titular y su frase están desde el primer pintado; solo la cita llega. */
    .cita { animation: aparece 1.1s cubic-bezier(.2, .7, .3, 1) .3s both; }
  }
  @keyframes sendero-entra { from { transform: scaleY(.55); opacity: 0; } }
  @keyframes niebla { to { transform: translate3d(12%, 0, 0); } }
  @keyframes aparece { from { opacity: 0; transform: translateY(.6rem); } }

  @media (min-width: 52rem) {
    .perdido { padding-inline: clamp(2rem, 8vw, 7rem); padding-bottom: 3rem; }
    .sendero { left: auto; right: 0; width: 60%; height: 100%; }
    .niebla { left: 20%; width: 100%; }
    .salidas { grid-template-columns: auto 1fr; align-items: center; width: auto; max-width: 46rem; }
    .salidas ul a { padding: 0 1.25rem; }
    .salida-principal { padding: 0 1.75rem !important; }
  }
</style>
