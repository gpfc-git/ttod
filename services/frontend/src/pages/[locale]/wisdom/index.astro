---
import Page from '../../../layouts/Page.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Estanteria from '../../../components/wisdom/Estanteria.astro';
import { isLocale, labels, loadWisdom } from '../../../content/wisdom';
import { copia } from '../../../content/estanteria';
import '../../../styles/tokens.css';
import '../../../styles/armario.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const { entries, failed } = await loadWisdom(locale);
const copy = labels[locale];
const t = copia[locale];
---
<Page lang={locale} title={`${t.titulo} — TTOD`}>
  <main class="armario-vista">
    <Breadcrumbs locale={locale} items={[{ label: copy.wisdom }]} />
    <Estanteria locale={locale} entries={entries} failed={failed} sesion={Astro.cookies.has('ttod_session')}>
      <a slot="acciones" class="armario-proponer" href={`/${locale}/wisdom/propose/`}>{copy.propose}</a>
    </Estanteria>
  </main>
</Page>
