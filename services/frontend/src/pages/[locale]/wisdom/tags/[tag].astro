---
import Page from '../../../../layouts/Page.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Bosque from '../../../../components/wisdom/Bosque.astro';
import { isLocale, labels, loadWisdom } from '../../../../content/wisdom';
import { copia } from '../../../../content/bosque';
import '../../../../styles/tokens.css';
import '../../../../styles/bosque.css';
const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });
const tag = Astro.params.tag;
// Empty/missing tag must 404 — do not match entries via includes('').
if (!tag) return new Response(null, { status: 404 });
const { entries: all, failed } = await loadWisdom(locale);
const entries = all.filter((entry) => entry.tags.includes(tag));
const copy = labels[locale];
const t = copia[locale];
---
<Page lang={locale} title={`${copy.tags}: ${tag}`}>
  <main class="bosque">
    <Breadcrumbs locale={locale} items={[{ label: copy.wisdom, href: `/${locale}/wisdom/` }, { label: tag }]} />
    <Bosque
      locale={locale}
      todas={all}
      entries={entries}
      failed={failed}
      activa={{ tipo: 'tags', valor: tag }}
      titulo={t.tituloFaceta(tag)}
      intro={t.introFaceta(tag, all.length)}
    />
  </main>
</Page>
