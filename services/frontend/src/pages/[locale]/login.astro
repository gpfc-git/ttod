---
import CieloRuyi from '../../components/estilo/CieloRuyi.astro';
import Page from '../../layouts/Page.astro';
import { isLocale } from '../../content/wisdom';
import { SESSION_COOKIE_NAME, getSessionUser, loginWithBackend, safeNextPath } from '../../lib/auth.server';

export const prerender = false;

const locale = Astro.params.locale;
if (!isLocale(locale)) return new Response(null, { status: 404 });

// A dónde se vuelve después de entrar: el `next` de la redirección o del pie, o
// la página de este mismo sitio desde la que se llegó. Nunca otro dominio.
const referer = Astro.request.headers.get('referer');
const desdeReferer = referer && new URL(referer, Astro.url).origin === Astro.url.origin
  ? new URL(referer).pathname : null;
let next = safeNextPath(Astro.url.searchParams.get('next') ?? desdeReferer, locale);

let loginError: 'credentials' | 'service' | null = null;
let email = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const rawEmail = formData.get('email');
  const password = formData.get('password');
  next = safeNextPath(formData.get('next'), locale);
  email = typeof rawEmail === 'string' ? rawEmail : '';

  if (typeof rawEmail !== 'string' || typeof password !== 'string') {
    loginError = 'credentials';
  } else if (rawEmail.trim() === '' || password === '') {
    // Un campo vacío nunca es una credencial válida: se rechaza aquí, sin llamar al backend.
    loginError = 'credentials';
  } else {
    // La contraseña solo viaja al backend, que la verifica con bcrypt; esta página no compara nada.
    const login = await loginWithBackend(rawEmail, password);
    if (login.ok) {
      Astro.cookies.set(SESSION_COOKIE_NAME, login.sessionToken, {
        httpOnly: true,
        sameSite: 'lax',
        secure: import.meta.env.PROD,
        path: '/',
        maxAge: login.expiresIn
      });
      return Astro.redirect(next, 303);
    }
    loginError = login.reason;
  }
} else if (await getSessionUser(Astro.request)) {
  // Ya hay sesión: no tiene sentido pedirla otra vez.
  return Astro.redirect(next);
}

const copy = locale === 'es'
  ? {
      title: 'Iniciar sesión · TTOD',
      description: 'Entra en tu cuenta de TTOD para guardar citas y proponer nuevas al corpus.',
      eyebrow: 'Tu cuenta',
      heading: 'Iniciar sesión',
      lead: 'Con la sesión abierta guardas citas en favoritos y propones citas nuevas al corpus.',
      email: 'Correo electrónico',
      password: 'Contraseña',
      show: 'Mostrar',
      hide: 'Ocultar',
      showLabel: 'Mostrar contraseña',
      submit: 'Entrar',
      busy: 'Entrando…',
      credentialsError: 'El correo o la contraseña no coinciden. Revísalos y vuelve a intentarlo.',
      serviceError: 'El servicio de cuentas no responde ahora mismo. Inténtalo de nuevo en un momento.',
      note: 'No hay registro abierto: por ahora la cuenta la configura quien administra esta instancia del curso.',
      back: 'Seguir sin entrar'
    }
  : {
      title: 'Log in · TTOD',
      description: 'Log in to your TTOD account to save quotes and propose new ones to the corpus.',
      eyebrow: 'Your account',
      heading: 'Log in',
      lead: 'With a session open you can save favourite quotes and propose new quotes to the corpus.',
      email: 'Email',
      password: 'Password',
      show: 'Show',
      hide: 'Hide',
      showLabel: 'Show password',
      submit: 'Log in',
      busy: 'Logging in…',
      credentialsError: 'The email or password does not match. Check them and try again.',
      serviceError: 'The account service is not answering right now. Please try again in a moment.',
      note: 'There is no open sign-up: for now the account is set up by whoever runs this course instance.',
      back: 'Continue without logging in'
    };
const errorText = loginError === 'credentials' ? copy.credentialsError : loginError === 'service' ? copy.serviceError : '';
const backHref = next === `/${locale}/account` ? `/${locale}/` : next;
---

<Page lang={locale} title={copy.title} description={copy.description}>
  <main class="acceso">
    <CieloRuyi semilla={11} />
    <div class="acceso-caja">
      <p class="acceso-ojo">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="acceso-lead">{copy.lead}</p>

      <div id="login-error" class="acceso-error" role="alert" aria-live="assertive" aria-atomic="true">
        {errorText && <p>{errorText}</p>}
      </div>

      <form method="post" class="acceso-form" data-login>
        <input type="hidden" name="next" value={next} />
        <div class="campo">
          <label for="email">{copy.email}</label>
          <input
            id="email" name="email" type="email" required
            autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false"
            value={email}
            aria-invalid={loginError === 'credentials' ? 'true' : undefined}
            aria-describedby={loginError ? 'login-error' : undefined}
          />
        </div>
        <div class="campo">
          <label for="password">{copy.password}</label>
          <div class="campo-clave">
            <input
              id="password" name="password" type="password" required autocomplete="current-password"
              aria-invalid={loginError === 'credentials' ? 'true' : undefined}
              aria-describedby={loginError ? 'login-error' : undefined}
              autofocus={!!loginError}
            />
            <button
              type="button" class="ver-clave" hidden
              aria-controls="password" aria-pressed="false" aria-label={copy.showLabel}
              data-show={copy.show} data-hide={copy.hide}
            >{copy.show}</button>
          </div>
        </div>
        <button type="submit" class="acceso-entrar" data-busy={copy.busy}>{copy.submit}</button>
      </form>

      <p class="acceso-nota">{copy.note}</p>
      <a class="acceso-volver" href={backHref}>{copy.back}</a>
    </div>
  </main>
</Page>

<style>
  /* El login en el cielo ruyi (el fondo de nubes que se van
     dibujando, y un poco de humo). El formulario va sobre su folio de
     papel opaco, con la misma curva de retablo que el oráculo: el cielo nunca toca el texto. */
  .acceso {
    position: relative; isolation: isolate;
    min-height: calc(100svh - 5rem);
    display: grid; align-content: center; justify-items: center;
    padding: clamp(1.25rem, 5vh, 4.5rem) 1rem clamp(3rem, 12vh, 7rem);
  }
  .acceso-caja {
    position: relative; z-index: 1; box-sizing: border-box; width: min(100%, 28rem);
    padding: 3rem clamp(1.25rem, 5vw, 2.25rem) 1.75rem;
    background: radial-gradient(120% 60% at 50% 0%, rgb(var(--ttod-paper-rgb)) 55%, #f6efdf 100%);
    border: 1px solid #dccfb3; border-radius: 50% 50% 1.5rem 1.5rem / 4rem 4rem 1.5rem 1.5rem;
    box-shadow: 0 2.5rem 5rem #5b4a3026, 0 .25rem 1rem #5b4a3014;
  }
  .acceso-ojo {
    margin: 0 0 .5rem; font-family: var(--ttod-font-ui); font-size: var(--ttod-text-ui);
    letter-spacing: var(--ttod-tracking-ui); text-transform: uppercase; font-weight: 500; color: var(--ttod-color-seal);
  }
  h1 { margin: 0; font-family: var(--ttod-font-titular); font-weight: 300; font-size: clamp(2.4rem, 10vw, 3.5rem); line-height: 1.05; }
  .acceso-lead { margin: .9rem 0 0; color: var(--ttod-color-muted); }

  .acceso-error:not(:has(p)) { display: none; }
  .acceso-error {
    margin-top: 1.25rem; padding: .85rem 1rem; border-radius: .9rem;
    background: rgb(154 51 36 / .09); border-inline-start: 3px solid var(--ttod-color-seal);
    color: #7a2619; font-family: var(--ttod-font-ui); font-size: .9375rem; line-height: 1.5;
  }
  .acceso-error p { margin: 0; }

  .acceso-form { display: grid; gap: 1.1rem; margin-top: 1.5rem; }
  .campo { display: grid; gap: .4rem; }
  .campo label { font-family: var(--ttod-font-ui); font-size: .9375rem; font-weight: 500; }
  .campo input {
    box-sizing: border-box; width: 100%; min-height: 52px; padding: 0 1rem;
    border: 1px solid var(--ttod-color-line); border-radius: .9rem;
    background: rgb(250 247 238); color: var(--ttod-color-ink);
    /* 16 px como mínimo: por debajo, Safari en iPhone amplía la página al enfocar. */
    font: 1rem/1.4 var(--ttod-font-ui);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .campo input:hover { border-color: var(--ttod-color-ink); }
  .campo input:focus-visible {
    outline: none; border-color: var(--ttod-color-focus);
    box-shadow: 0 0 0 3px rgb(36 93 146 / .35);
  }
  .campo input[aria-invalid='true'] { border-color: var(--ttod-color-seal); }
  .campo-clave { position: relative; }
  .campo-clave input { padding-inline-end: 5.5rem; }
  .ver-clave {
    position: absolute; inset-block: 4px; inset-inline-end: 4px; min-width: 44px; padding: 0 .9rem;
    border: 0; border-radius: .7rem; background: transparent; color: var(--ttod-color-ink); cursor: pointer;
    font: 500 var(--ttod-text-ui)/1 var(--ttod-font-ui); letter-spacing: .08em; text-transform: uppercase;
  }
  .ver-clave:hover { background: rgb(27 23 16 / .07); }
  .ver-clave:focus-visible { outline: 3px solid var(--ttod-color-focus); outline-offset: 0; }

  .acceso-entrar {
    min-height: 54px; margin-top: .35rem; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--ttod-color-ink); color: rgb(var(--ttod-paper-rgb));
    font: 500 .875rem/1 var(--ttod-font-ui); letter-spacing: .12em; text-transform: uppercase;
    transition: background-color .25s ease, transform .3s cubic-bezier(.2, .7, .3, 1);
  }
  .acceso-entrar:hover { background: #000; }
  .acceso-entrar:active { transform: scale(.985); }
  .acceso-entrar:focus-visible { outline: 3px solid var(--ttod-color-focus); outline-offset: 3px; }
  .acceso-entrar[aria-disabled='true'] { cursor: progress; opacity: .8; }

  .acceso-nota { margin: 1.5rem 0 .25rem; font-family: var(--ttod-font-ui); font-size: .9375rem; line-height: 1.55; color: var(--ttod-color-muted); }
  .acceso-volver {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--ttod-font-ui); font-size: .9375rem; color: var(--ttod-color-accent);
  }
  .acceso-volver:focus-visible { outline: 3px solid var(--ttod-color-focus); outline-offset: 2px; border-radius: 4px; }

  @media (prefers-reduced-motion: no-preference) {
    .acceso-caja { animation: llega .9s cubic-bezier(.2, .7, .3, 1) .15s both; }
  }
  @keyframes llega { from { opacity: 0; transform: translateY(.5rem); } }
</style>

<script>
  import { entintar } from '../../components/estilo/letras';
  // El título se entinta letra a letra, como en el oráculo (kit de estilo).
  entintar(document.querySelector('.acceso h1'), { retraso: .15 });

  const form = document.querySelector<HTMLFormElement>('[data-login]');
  const ver = form?.querySelector<HTMLButtonElement>('.ver-clave');
  const clave = form?.querySelector<HTMLInputElement>('#password');

  if (ver && clave) {
    // Sin JS el botón no existe: no promete lo que no puede hacer.
    ver.hidden = false;
    ver.addEventListener('click', () => {
      const visible = clave.type === 'password';
      clave.type = visible ? 'text' : 'password';
      ver.setAttribute('aria-pressed', String(visible));
      ver.textContent = visible ? ver.dataset.hide! : ver.dataset.show!;
      clave.focus();
    });
  }

  form?.addEventListener('submit', (ev) => {
    const boton = form.querySelector<HTMLButtonElement>('.acceso-entrar');
    if (!boton) return;
    // Un segundo toque no manda el formulario dos veces.
    if (boton.getAttribute('aria-disabled') === 'true') { ev.preventDefault(); return; }
    if (clave) clave.type = 'password';
    boton.setAttribute('aria-disabled', 'true');
    boton.textContent = boton.dataset.busy!;
  });
</script>
