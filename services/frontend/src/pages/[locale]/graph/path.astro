---
// /graph/path: el sendero entre dos aforismos (eliges dos citas y se enciende el
// camino que las une) y, debajo, el grafo del código de este repositorio, que se
// carga solo cuando entra en pantalla. El grafo de aforismos del Equipo 2 sigue
// en /graph, sin tocar.
import CodigoGrafo from '../../../components/graph/CodigoGrafo.svelte';
import SenderoAforismos from '../../../components/graph/SenderoAforismos.svelte';
import Page from '../../../layouts/Page.astro';
import grafo from '../../../../public/data/grafo-codigo.json';
import { ID_PLANO_INCRUSTADO } from '../../../components/graph/sendero';
import { grafoInicial, planoInicial } from '../../../lib/grafo.server';

const locale = Astro.params.locale;
if (locale !== 'en' && locale !== 'es') return new Response(null, { status: 404 });

// Las posiciones del plano 2D, ya calculadas: así la constelación se pinta en
// cuanto llega el grafo, sin los ~220 ms de cálculo en el móvil (`lib/grafo.server.ts`).
const plano = planoInicial(locale);
// Y el grafo mismo, de la copia del servidor: la constelación no espera al backend.
const grafoTexto = grafoInicial();
const r = grafo.resumen;
const miles = (n: number) => n.toLocaleString(locale === 'es' ? 'es-ES' : 'en-GB');

const copia = {
  en: {
    titulo: 'The code that reads itself',
    intro: 'TTOD keeps a database of wisdom about writing software. This view turns the same instrument on its own repository: every function, every class, and who calls whom.',
    cifras: [
      { valor: miles(r.funciones), palabra: 'functions' },
      { valor: miles(r.clases), palabra: 'classes' },
      { valor: miles(r.ficheros), palabra: 'files' },
    ],
    cierre: `${miles(r.llamadas)} calls, one at a time`,
    // La dirección se rotula dentro del dibujo, que es donde se mira: en vertical
    // los que llaman quedan arriba, no a la izquierda, y esta frase mentía.
    pie: 'Drawing them all at once makes a stain, not a graph. Below, one symbol at a time, with who calls it and what it calls in their own labelled groups.',
    aforismos: 'The graph of the aphorisms',
    titulo_pagina: 'The path between two aphorisms · TTOD',
  },
  es: {
    titulo: 'El código que se lee a sí mismo',
    intro: 'TTOD guarda una base de sabiduría sobre escribir software. Esta vista apunta el mismo instrumento a su propio repositorio: cada función, cada clase y quién llama a quién.',
    cifras: [
      { valor: miles(r.funciones), palabra: 'funciones' },
      { valor: miles(r.clases), palabra: 'clases' },
      { valor: miles(r.ficheros), palabra: 'ficheros' },
    ],
    cierre: `${miles(r.llamadas)} llamadas, de una en una`,
    pie: 'Dibujarlas todas a la vez da una mancha, no un grafo. Abajo, un símbolo cada vez, con quién lo llama y a quién llama, cada grupo con su rótulo.',
    aforismos: 'El grafo de los aforismos',
    titulo_pagina: 'El sendero entre dos aforismos · TTOD',
  },
}[locale];
---
<Page lang={locale} title={copia.titulo_pagina}>
  {/*
    Los dos conjuntos de datos y la librería del 3D, pedidos en cuanto se lee la
    página y no cuando despierta la isla: esperar a la isla eran dos segundos de
    reloj parados (medido a 390 con 4G lenta: la isla arranca en el 1,5 y hasta
    entonces no se pide nada). Aquí salen a la vez en el 0,4 y la constelación
    está en pie mucho antes de que a nadie le dé tiempo a bajar. La isla usa lo
    que encuentre pedido; si este trozo no llegó a correr, lo pide ella.
  */}
  <script>
    // Lo que se deja pedido para las dos islas, que lo recogen de `window`.
    const w = window as typeof window & { __senderoDatos?: unknown; __senderoLibreria?: unknown; __codigoDatos?: unknown };
    const comoJson = (ruta: string) =>
      fetch(ruta, { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null);
    // El grafo viene ya dentro de la página si el servidor lo tenía (ver
    // `lib/grafo.server.ts`); si no, se pide como siempre.
    const incrustado = document.getElementById('ttod-grafo');
    const grafo = incrustado
      ? Promise.resolve().then(() => JSON.parse(incrustado.textContent ?? 'null'))
      : comoJson('/api/v1/graph');
    w.__senderoDatos = { corpus: comoJson('/api/v1/wisdom/sample'), grafo };
    // Preguntar por un contexto WebGL de prueba cuesta 114 ms en una máquina sin
    // tarjeta gráfica; que exista el constructor es gratis y basta para decidir
    // si vale la pena bajarse los 429 KB de la librería.
    if ('WebGL2RenderingContext' in window || 'WebGLRenderingContext' in window) {
      w.__senderoLibreria = import('3d-force-graph');
    }

    // El grafo del código vive más abajo y despierta al verse. Despertar era
    // bajarse su módulo, compilarlo y pedir el índice del repositorio, todo
    // encima del dedo que estaba bajando: una tarea de 243 ms a mitad del
    // scroll (medido a 390 con la CPU a 1/4 y 4G rápida; de esos 243, 215 son
    // descargar y compilar, no correr). Aquí se baja y se compila al leer la
    // página, en paralelo con las dos llamadas al backend —que tardan 1,2 s
    // cada una y son las que de verdad mandan—, así que no cuesta reloj. Es
    // además lo que hace el sitio ya publicado: ahí Astro deja la isla
    // precargada en la cabecera y solo queda dibujarla. Esperar a un hueco
    // libre del hilo no vale: con el backend así de lento no hay hueco antes
    // de que el visitante llegue abajo, y el plazo de respaldo soltaba los
    // 385 ms en el peor momento posible.
    w.__codigoDatos = comoJson('/data/grafo-codigo.json');
    import('../../../components/graph/CodigoGrafo.svelte');
  </script>
  {/*
    La constelación es lo primero de la página: siempre está a la vista, así que
    esperar al observador de visibilidad solo retrasaba su JS medio segundo (de
    300 a 876 ms, medido a 390 con 4G lenta) y con él los datos y la escena. Con
    `client:load` arranca de una y la escena está en pie antes de que alguien
    baje. El grafo del código, que vive más abajo, sigue esperando a verse.
  */}
  {grafoTexto && <script type="application/json" id="ttod-grafo" set:html={grafoTexto.replace(/</g, '\\u003c')} />}
  {plano && <script type="application/json" id={ID_PLANO_INCRUSTADO} set:html={JSON.stringify(plano).replace(/</g, '\\u003c')} />}
  <SenderoAforismos client:load lang={locale} />
  <main class="grafo-ancho">
    <section class="grafo-codigo" aria-labelledby="grafo-codigo-titulo">
      <h2 id="grafo-codigo-titulo">{copia.titulo}</h2>
      <p class="grafo-codigo__intro">{copia.intro}</p>
      <ol class="grafo-codigo__cifras">
        {copia.cifras.map((c) => (
          <li><span class="grafo-codigo__valor">{c.valor}</span><span class="grafo-codigo__palabra">{c.palabra}</span></li>
        ))}
      </ol>
      <p class="grafo-codigo__pie">{copia.cierre}. {copia.pie}</p>
      <CodigoGrafo client:visible lang={locale} />
    </section>
    <p class="grafo-puerta">
      <a href={`/${locale}/graph`}>{copia.aforismos} →</a>
    </p>
  </main>
</Page>

<style>
  /* La banda de detrás de la cabecera (ver `Page.astro`) va del tono del canto
     de arriba de la escena, cuyo velo de lectura empieza en #0c0a07: con el
     degradado de la sección se veía una costura más clara a 61 px. */
  :global(.sendero) { --ttod-banda-arriba: #0c0a07; }
  /* Esta vista es un instrumento, no una columna de lectura: necesita todo el ancho. */
  .grafo-ancho {
    /* `main` viene con la columna de lectura de 48rem; el instrumento no la usa. */
    max-width: none;
    width: min(var(--ttod-max-content), calc(100% - 3rem));
    margin-inline: auto;
    padding-block: var(--ttod-space-12);
  }
  /* El grafo del código ya no abre la vista: es la segunda sección, con su
     propia entradilla editorial en vez del paisaje del hero (que se repetía). */
  .grafo-codigo h2 {
    font-family: var(--ttod-font-titular);
    font-weight: 300;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    margin: 0 0 var(--ttod-space-4);
  }
  .grafo-codigo__intro {
    font-family: var(--ttod-font-body);
    font-size: var(--ttod-text-lg);
    line-height: 1.55;
    max-width: 46ch;
    margin: 0;
  }
  .grafo-codigo__cifras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ttod-space-6) var(--ttod-space-12);
    list-style: none;
    margin: var(--ttod-space-8) 0;
    padding: 0;
  }
  .grafo-codigo__cifras li { display: grid; gap: var(--ttod-space-1); }
  .grafo-codigo__valor {
    font-family: var(--ttod-font-titular);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    line-height: 1;
  }
  .grafo-codigo__palabra {
    font-family: var(--ttod-font-ui);
    font-size: var(--ttod-text-ui);
    letter-spacing: var(--ttod-tracking-ui);
    text-transform: uppercase;
    color: var(--ttod-color-muted);
  }
  .grafo-codigo__pie {
    font-family: var(--ttod-font-body);
    font-size: var(--ttod-text-base);
    line-height: 1.6;
    max-width: 58ch;
    margin: 0 0 var(--ttod-space-8);
    color: var(--ttod-color-muted);
  }
  .grafo-puerta {
    margin: var(--ttod-space-12) 0 0;
    padding-top: var(--ttod-space-6);
    border-top: 1px solid var(--ttod-color-line-subtle);
    font-family: var(--ttod-font-ui);
    font-size: var(--ttod-text-ui);
    letter-spacing: var(--ttod-tracking-ui);
    text-transform: uppercase;
  }
  /* La puerta es una píldora de 44 px: antes era una línea de 16 px de alto, el
     único fallo que revisar-pagina marcaba en esta vista a 390 y 768. */
  .grafo-puerta a {
    color: var(--ttod-color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--ttod-space-4);
    margin-inline-start: calc(var(--ttod-space-4) * -1);
    border: 1px solid transparent;
    border-radius: 999px;
  }
  .grafo-puerta a:hover,
  .grafo-puerta a:focus-visible { border-color: currentColor; }
</style>
